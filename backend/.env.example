# ─────────────────────────────────────────
# vlivechat Backend — Environment Variables
# ─────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Frontend / Widget Origins (comma-separated)
FRONTEND_URL=http://localhost:5173
WIDGET_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vlivechat
DB_USER=vlcuser
DB_PASSWORD=vlcpassword123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SLA Defaults (minutes)
SLA_FIRST_RESPONSE=5
SLA_RESOLUTION=60

# Superadmin (initial setup)
SUPERADMIN_EMAIL=superadmin@vlivechat.com
SUPERADMIN_PASSWORD=SuperAdmin@2024!
